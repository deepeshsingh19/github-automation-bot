generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  SKIPPED
}

enum ActionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum RuleEventType {
  ISSUES
  PULL_REQUEST
}

enum MatchField {
  TITLE
  BODY
  AUTHOR
}

enum MatchOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
}

enum ActionType {
  ADD_LABEL
  COMMENT
  SLACK
  AI
}

model User {
  id            String         @id @default(cuid())
  githubId      String         @unique
  githubLogin   String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  installations Installation[]
}

model Installation {
  id           String   @id @default(cuid())
  githubId     BigInt   @unique
  userId       String
  accountLogin String
  active       Boolean  @default(true)
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@index([userId])
}

model Repository {
  id                    String   @id @default(cuid())
  githubRepoId          BigInt   @unique
  installationId        String
  owner                 String
  name                  String
  fullName              String
  active                Boolean  @default(true)
  slackWebhookEncrypted String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  rules        Rule[]
  events       Event[]

  @@index([installationId])
  @@index([active])
}

model Rule {
  id            String        @id @default(cuid())
  repositoryId  String
  name          String
  eventType     RuleEventType
  matchField    MatchField
  matchOperator MatchOperator
  matchValue    String
  actions       Json
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  actionLogs Action[]

  @@index([repositoryId])
  @@index([repositoryId, enabled])
}

model Event {
  id               String      @id @default(cuid())
  repositoryId     String
  githubDeliveryId String      @unique
  eventType        String
  action           String?
  payload          Json
  status           EventStatus @default(PENDING)
  attempts         Int         @default(0)
  nextRetryAt      DateTime?
  lockedAt         DateTime?
  lastError        String?
  aiSummary        String?
  aiSuggestedLabel String?
  aiPriority       String?
  receivedAt       DateTime    @default(now())
  processedAt      DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  actions    Action[]

  @@index([repositoryId, receivedAt])
  @@index([status, nextRetryAt])
  @@index([lockedAt])
}

model Action {
  id          String       @id @default(cuid())
  eventId     String
  ruleId      String?
  actionType  ActionType
  actionKey   String
  status      ActionStatus @default(PENDING)
  error       String?
  response    Json?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rule  Rule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([eventId, actionKey])
  @@index([eventId])
  @@index([status])
}
